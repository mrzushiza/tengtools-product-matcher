    #tt-match .ttm-hero p { margin-top:8px; font-size:12px; line-height:1.45; }
    #tt-match .ttm-account { align-self:stretch; width:100%; min-width:0; padding:8px 10px; }
    #tt-match .ttm-avatar { flex-basis:34px; width:34px; height:34px; font-size:11px; }
    #tt-match .ttm-account strong { margin-bottom:2px; font-size:12px; }
    #tt-match .ttm-panel { margin-top:16px; }
    #tt-match .ttm-start { padding:22px 14px 20px; }
    #tt-match .ttm-start h2,#tt-match .ttm-results-head h2 { font-size:20px; }
    #tt-match .ttm-start h2:after,#tt-match .ttm-results-head h2:after { width:42px; height:3px; margin-top:9px; }
    #tt-match .ttm-start-intro { margin:7px 0 15px; font-size:12px; line-height:1.45; }
    #tt-match .ttm-entry { grid-template-columns:1fr; }
    #tt-match .ttm-manual-context { align-items:flex-start; flex-direction:column; }
    #tt-match .ttm-input { min-height:48px; padding:0 12px; font-size:12px; }
    #tt-match .ttm-entry .ttm-primary,#tt-match .ttm-entry .ttm-upload-primary { width:100%; min-height:46px; }
    #tt-match .ttm-scope { margin-top:14px; }
    #tt-match .ttm-scope-options { display:grid; grid-template-columns:minmax(0,1.35fr) minmax(0,.72fr) minmax(0,1.08fr); gap:4px; }
    #tt-match .ttm-scope-option { justify-content:center; width:100%; min-width:0; padding:7px 5px; font-size:10px; white-space:nowrap; }
    #tt-match .ttm-scope-icon { width:14px; height:14px; margin-right:4px; }
    #tt-match .ttm-ai-control { align-items:flex-start; font-size:11px; line-height:1.4; }
    #tt-match .ttm-tools .ttm-quiet,#tt-match .ttm-scope-option,#tt-match .ttm-action-menu summary { min-height:44px; }
    #tt-match .ttm-suggestions { grid-template-columns:1fr; }
    #tt-match .ttm-suggestion { grid-template-columns:56px minmax(0,1fr); padding:12px; }
    #tt-match .ttm-suggestion-media .ttm-product-image,#tt-match .ttm-suggestion-media .ttm-image-fallback { width:56px; height:56px; }
    #tt-match .ttm-pagination { align-items:flex-start; flex-direction:column; }
    #tt-match .ttm-pagination-controls { justify-content:flex-start; width:100%; }
    #tt-match .ttm-results-head { padding:20px 14px 16px; }
    #tt-match .ttm-counts { gap:4px; font-size:11px; }
    #tt-match .ttm-head-actions { display:grid; grid-template-columns:1fr 1fr; gap:6px; width:100%; }
    #tt-match .ttm-head-actions button { width:100%; min-width:0; min-height:42px; padding:8px 7px; font-size:10.5px; }
    #tt-match #ttm-download { grid-column:1/-1; order:1; }
    #tt-match #ttm-add-row { order:2; }
    #tt-match #ttm-save-session { order:3; }
    #tt-match #ttm-saved-sessions { order:4; }
    #tt-match #ttm-clear-saved { order:5; }
    #tt-match .ttm-tools { display:grid; grid-template-columns:.65fr 1fr 1.35fr .9fr; gap:3px; padding:10px 12px; }
    #tt-match .ttm-tools .ttm-filter { min-width:0; padding:5px 3px; font-size:9px; white-space:normal; }
    #tt-match .ttm-tools .ttm-filter .ttm-icon { width:12px; height:12px; }
    #tt-match #ttm-reset-columns,#tt-match .ttm-columns-control { display:none; }
    #tt-match .ttm-dialog-actions button { flex:1 1 130px; }
    #tt-match .ttm-undo { align-items:flex-start; flex-wrap:wrap; }
    #tt-match .ttm-component,#tt-match .ttm-component-form { grid-template-columns:1fr; }
    #tt-match .ttm-gate { margin:22px 10px; padding:26px 18px; }
    #tt-match .ttm-gate h1 { font-size:29px; }
    #tt-match .ttm-table-wrap { overflow:visible; padding:10px 10px 14px; background:#fafafa; }
    #tt-match table,#tt-match tbody { display:block; width:100%; }
    #tt-match thead { display:none; }
    #tt-match tbody { display:grid; gap:9px; }
    #tt-match tbody > tr { display:block; overflow:hidden; border:1px solid #d9dde2; background:#fff; box-shadow:inset 4px 0 0 #aab0b7; }
    #tt-match tbody > tr.is-matched { box-shadow:inset 4px 0 0 var(--green); }
    #tt-match tbody > tr.is-review { box-shadow:inset 4px 0 0 var(--red); }
    #tt-match tbody > tr.is-ignored { box-shadow:inset 4px 0 0 #858d98; }
    #tt-match tr.is-review > td,#tt-match tr.is-ignored > td { color:inherit; background:#fff; }
    #tt-match .ttm-mobile-summary-cell { display:block!important; padding:0!important; border:0; }
    #tt-match .ttm-mobile-summary { display:grid; grid-template-columns:auto minmax(0,1fr) auto; grid-template-areas:"row item state" "row meta arrow"; align-items:center; gap:2px 9px; width:100%; min-height:72px; padding:11px 12px 11px 15px; border:0; color:#20252c; background:#fff; text-align:left; }
    #tt-match tr.is-review .ttm-mobile-summary { background:#fff8f7; }
    #tt-match tr.is-ignored .ttm-mobile-summary { background:#f5f5f5; }
    #tt-match .ttm-mobile-row-number { grid-area:row; align-self:start; min-width:32px; padding-top:2px; color:#5d6570; font-size:10px; font-weight:700; }
    #tt-match .ttm-mobile-item { grid-area:item; min-width:0; overflow:hidden; font-size:12px; font-weight:700; line-height:1.35; text-overflow:ellipsis; white-space:nowrap; }
    #tt-match .ttm-mobile-meta { grid-area:meta; min-width:0; overflow:hidden; color:#646d78; font-size:10px; line-height:1.35; text-overflow:ellipsis; white-space:nowrap; }
    #tt-match .ttm-mobile-state { grid-area:state; display:flex; align-items:center; justify-content:center; color:#69717c; }
    #tt-match .ttm-mobile-state--matched { color:var(--green); }
    #tt-match .ttm-mobile-state--review { color:#b3261e; }
    #tt-match .ttm-mobile-arrow { grid-area:arrow; color:#606975; }
    #tt-match .ttm-mobile-summary .ttm-icon { width:18px; height:18px; }
    #tt-match .ttm-mobile-arrow .ttm-icon { transition:transform .16s ease; }
    #tt-match tr.is-mobile-open .ttm-mobile-arrow .ttm-icon { transform:rotate(180deg); }
    #tt-match tbody > tr > td[data-column] { display:none; }
    #tt-match tbody > tr.is-mobile-open > td[data-column]:not([hidden]):not([data-column="row"]) { display:grid; grid-template-columns:86px minmax(0,1fr); gap:10px; padding:9px 12px 9px 15px; border-bottom:1px solid #eceef0; font-size:11px; line-height:1.4; }
    #tt-match tbody > tr.is-mobile-open > td[data-column]:not([data-column="row"])::before { color:#66707b; font-size:9px; font-weight:700; letter-spacing:.035em; text-transform:uppercase; content:attr(data-label); }
    #tt-match tbody > tr.is-mobile-open > td[data-column="inputTitle"] { font-size:12px; }
    #tt-match tbody > tr.is-mobile-open > td[data-column="status"] .ttm-status-indicators { align-self:start; }
    #tt-match tbody > tr.is-mobile-open > td[data-column="tengTitle"] .ttm-product-cell { grid-template-columns:48px minmax(0,1fr); }
    #tt-match tbody > tr.is-mobile-open > td[data-column="actions"] { border-bottom:0; }
    #tt-match .ttm-action-menu summary { width:100%; }
    #tt-match tr.ttm-undo-row { display:block; }
    #tt-match tr.ttm-undo-row > td { display:block!important; padding:12px!important; border:0; box-shadow:none; }
    #tt-match .ttm-group-detail { margin-top:-9px; }
    #tt-match .ttm-group-detail > td { display:block!important; }
    #tt-match .ttm-group-panel { padding:14px; }
    #tt-match .ttm-note { padding:12px 14px; font-size:11px; }
  }
</style>

<div id="tt-match" data-catalog-url="{{ 'tt-match-tengtools.json' | asset_url }}" data-xlsx-url="{{ 'tt-match-xlsx.min.js' | asset_url }}" data-pdf-url="{{ 'tt-match-pdf.min.js' | asset_url }}" data-pdf-worker-url="{{ 'tt-match-pdf.worker.min.js' | asset_url }}" data-session-api-url="/apps/matcher-sessions" data-customer-key="{{ customer.id | default: 'preview' }}">
  {% if customer %}
    <main class="page-width ttm-shell" aria-labelledby="ttm-title">
      <header class="ttm-hero">
        <div class="ttm-hero-copy">
          <h1 id="ttm-title">Product cross-referencing</h1>
          <span class="ttm-title-rule" aria-hidden="true"></span>
          <p>Match tools across the full TengTools range and download product data for your procurement system.</p>
        </div>
        <div class="ttm-account" aria-label="Signed-in account">
          <span class="ttm-avatar" aria-hidden="true">
            <span>{{ customer.first_name | slice: 0, 1 | upcase }}{{ customer.last_name | slice: 0, 1 | upcase }}</span>
            {% if customer.metafields.custom.profile_photo.value %}
              <img src="{{ customer.metafields.custom.profile_photo.value | image_url: width: 96 }}" alt="" width="48" height="48" loading="lazy">
            {% endif %}
          </span>
          <div class="ttm-account-copy">
            <strong>{{ customer.name | default: customer.email | escape }}</strong>
            <div class="ttm-account-links"><a href="{{ routes.account_url }}">My account</a><span aria-hidden="true">·</span><a href="{{ routes.account_logout_url }}">Log out</a></div>
          </div>
        </div>
      </header>

      <section id="ttm-start-panel" class="ttm-panel ttm-start" aria-labelledby="ttm-start-title">
        <h2 id="ttm-start-title">What do you need to match?</h2>
        <p id="ttm-start-intro" class="ttm-start-intro">Enter a tool name or item ID, or upload an existing stock list. Nothing is priced or ordered here.</p>
        <div id="ttm-manual-context" class="ttm-manual-context" role="status" hidden>
          <div id="ttm-manual-label"></div>
          <button id="ttm-manual-cancel" class="ttm-quiet" type="button"><svg class="ttm-icon" aria-hidden="true" viewBox="0 0 24 24"><path d="m6 6 12 12M18 6 6 18"></path></svg>Cancel manual match</button>
        </div>
        <form id="ttm-search-form" class="ttm-entry">
          <label class="ttm-visually-hidden" for="ttm-query">Tool name or item ID</label>
          <input class="ttm-input" id="ttm-query" type="search" autocomplete="off" placeholder="Try “combination pliers”, “MB453-7” or a competitor item ID">
          <button class="ttm-primary" type="submit"><svg class="ttm-icon" aria-hidden="true" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-4-4"></path></svg>Find matches</button>
          <input class="ttm-file" id="ttm-file" type="file" accept=".xlsx,.xls,.csv,.pdf,application/pdf,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet">
          <label class="ttm-secondary ttm-upload-primary" for="ttm-file"><svg class="ttm-icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M12 16V4"></path><path d="m7 9 5-5 5 5"></path><path d="M5 20h14"></path></svg>Upload Excel, CSV or PDF</label>
        </form>
        <div class="ttm-data-info">
          <button id="ttm-info-trigger" class="ttm-info-trigger" type="button" aria-expanded="false" aria-controls="ttm-info-box" aria-label="How your data is handled"><span aria-hidden="true">ⓘ</span></button>
          <div id="ttm-info-box" class="ttm-info-box" role="dialog" aria-labelledby="ttm-info-title" hidden>
            <button id="ttm-info-close" class="ttm-info-close" type="button" aria-label="Close information"><svg class="ttm-icon" aria-hidden="true" viewBox="0 0 24 24"><path d="m6 6 12 12M18 6 6 18"></path></svg></button>
            <strong id="ttm-info-title">How your data is handled</strong>
            <p id="ttm-save-state" role="status">Your working table is kept on this device until you choose Save session.</p>
            <p>The original uploaded file never leaves this device. When you save a session, only the matching table and its selected results are stored securely in Shopify so you and TengTools sales representatives can reopen it.</p>
            <p>When enhanced review is enabled, extracted tool descriptions and shortlisted TengTools candidates—not the original document—are processed securely to identify the requested tool and assess possible equivalents.</p>
          </div>
        </div>
        <fieldset class="ttm-scope">
          <legend class="ttm-visually-hidden">Product types to include</legend>
          <div class="ttm-scope-options">
            <label class="ttm-scope-option"><input type="checkbox" name="ttm-product-type" value="individual" checked><svg class="ttm-scope-icon ttm-scope-icon--active" aria-hidden="true" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"></circle><path d="m8 12 3 3 5-6"></path></svg><svg class="ttm-scope-icon ttm-scope-icon--inactive" aria-hidden="true" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"></circle><path d="M12 8v8M8 12h8"></path></svg>Individual items</label>
            <label class="ttm-scope-option"><input type="checkbox" name="ttm-product-type" value="set" checked><svg class="ttm-scope-icon ttm-scope-icon--active" aria-hidden="true" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"></circle><path d="m8 12 3 3 5-6"></path></svg><svg class="ttm-scope-icon ttm-scope-icon--inactive" aria-hidden="true" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"></circle><path d="M12 8v8M8 12h8"></path></svg>Sets</label>
            <label class="ttm-scope-option"><input type="checkbox" name="ttm-product-type" value="kit"><svg class="ttm-scope-icon ttm-scope-icon--active" aria-hidden="true" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"></circle><path d="m8 12 3 3 5-6"></path></svg><svg class="ttm-scope-icon ttm-scope-icon--inactive" aria-hidden="true" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"></circle><path d="M12 8v8M8 12h8"></path></svg>Complete kits</label>
          </div>
          <label class="ttm-ai-control"><input id="ttm-ai-enabled" type="checkbox" checked><span><strong>Enhanced review</strong> for uncertain and competitor items</span></label>
        </fieldset>
        <p id="ttm-status" class="ttm-statusline" role="status" aria-live="polite">Loading the TengTools product master…</p>
        <div id="ttm-suggestions" class="ttm-suggestions" hidden></div>
        <nav id="ttm-pagination" class="ttm-pagination" aria-label="Search result pages" hidden></nav>
      </section>

      <section class="ttm-panel ttm-results" aria-labelledby="ttm-results-title">
        <div class="ttm-results-head">
          <div>
            <h2 id="ttm-results-title">Match review</h2>
            <div class="ttm-counts" aria-live="polite"><span id="ttm-total">0 rows</span><span id="ttm-matched">0 matched</span><span id="ttm-review">0 need review</span><span id="ttm-ignored">0 ignored</span></div>
          </div>
          <div class="ttm-head-actions">
            <button id="ttm-add-row" class="ttm-secondary" type="button"><svg class="ttm-icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"></path></svg>Add Row</button>
            <button id="ttm-clear-saved" class="ttm-secondary" type="button" disabled><svg class="ttm-icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M4 7h16M9 7V4h6v3M7 7l1 13h8l1-13"></path></svg>Clear Table</button>
            <button id="ttm-saved-sessions" class="ttm-secondary" type="button"><svg class="ttm-icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M4 5h16v14H4z"></path><path d="M8 9h8M8 13h8"></path></svg>Saved sessions</button>
            <button id="ttm-save-session" class="ttm-secondary" type="button" disabled><svg class="ttm-icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M5 4h12l2 2v14H5z"></path><path d="M8 4v6h8V4M8 16h8"></path></svg>Save session</button>
            <button id="ttm-download" class="ttm-primary" type="button" disabled><svg class="ttm-icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M12 4v12"></path><path d="m7 11 5 5 5-5"></path><path d="M5 20h14"></path></svg>Download</button>
          </div>
        </div>
        <div class="ttm-tools" role="group" aria-label="Filter rows">
          <button class="ttm-quiet ttm-filter" type="button" data-filter="all" aria-pressed="true"><svg class="ttm-icon" aria-hidden="true" viewBox="0 0 24 24"><rect x="4" y="4" width="6" height="6"></rect><rect x="14" y="4" width="6" height="6"></rect><rect x="4" y="14" width="6" height="6"></rect><rect x="14" y="14" width="6" height="6"></rect></svg>All</button>
          <button class="ttm-quiet ttm-filter" type="button" data-filter="matched" aria-pressed="false"><svg class="ttm-icon" aria-hidden="true" viewBox="0 0 24 24"><path d="m5 12 4 4L19 6"></path></svg>Matched</button>
          <button class="ttm-quiet ttm-filter" type="button" data-filter="review" aria-pressed="false"><svg class="ttm-icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M12 3 2.5 20h19L12 3Z"></path><path d="M12 9v4M12 17h.01"></path></svg>Needs review</button>
          <button class="ttm-quiet ttm-filter" type="button" data-filter="ignored" aria-pressed="false"><svg class="ttm-icon" aria-hidden="true" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"></circle><path d="m6 6 12 12"></path></svg>Ignored</button>
          <button id="ttm-reset-columns" class="ttm-quiet" type="button"><svg class="ttm-icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M4 7v5h5"></path><path d="M5.5 16a8 8 0 1 0 .5-9l-2 5"></path></svg>Reset columns</button>
          <div class="ttm-columns-control">
            <button id="ttm-columns-trigger" class="ttm-quiet ttm-columns-trigger" type="button" aria-expanded="false" aria-controls="ttm-columns-menu"><svg class="ttm-icon" aria-hidden="true" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14"></rect><path d="M9 5v14M15 5v14"></path></svg>Columns <span class="ttm-kebab" aria-hidden="true">⋮</span></button>
            <div id="ttm-columns-menu" class="ttm-columns-menu" role="dialog" aria-label="Choose visible columns" hidden>
              <span class="ttm-columns-menu-title">Visible columns</span>
              <div id="ttm-column-options"></div>
            </div>
          </div>
        </div>
        <div class="ttm-table-wrap">
          <table>
            <thead><tr>
              <th><button type="button" data-sort="row">Row</button></th>
              <th><button type="button" data-sort="inputBrand">Brand</button></th>
              <th><button type="button" data-sort="inputId">Item ID</button></th>
              <th><button type="button" data-sort="inputTitle">Description</button></th>
              <th><button type="button" data-sort="quantity">Qty</button></th>
              <th><button type="button" data-sort="unit">Unit</button></th>
              <th title="Shows whether this row is confirmed, still requires review, or was intentionally ignored"><button type="button" data-sort="status">Status</button></th>
              <th><button type="button" data-sort="category">Category</button></th>
              <th><button type="button" data-sort="tengSku">Teng ID</button></th>
              <th><button type="button" data-sort="tengTitle">Teng match</button></th>
              <th><button type="button" data-sort="unspsc">UNSPSC</button></th>
              <th><span>Actions</span></th>
            </tr></thead>
            <tbody id="ttm-body"></tbody>
          </table>
          <div id="ttm-empty" class="ttm-empty">Search for a tool or upload a list to begin.</div>
        </div>
        <div class="ttm-note">Red rows have no reliable match. Review, select a TengTools product manually, or ignore. Manual selections are marked in the export.</div>
      </section>
      <dialog id="ttm-upload-dialog" class="ttm-dialog ttm-upload-dialog" aria-labelledby="ttm-upload-title" aria-describedby="ttm-upload-message">
        <div class="ttm-dialog-body">
          <h2 id="ttm-upload-title">Importing and matching</h2>
          <span id="ttm-upload-filename" class="ttm-upload-file"></span>
          <div class="ttm-upload-progress-row"><progress id="ttm-upload-progress" max="100" value="0"></progress><span id="ttm-upload-percent" class="ttm-upload-percent">0%</span></div>
          <p id="ttm-upload-message" class="ttm-upload-message">Preparing file…</p>
        </div>
        <div class="ttm-dialog-actions">
          <button id="ttm-upload-cancel" class="ttm-secondary" type="button"><svg class="ttm-icon" aria-hidden="true" viewBox="0 0 24 24"><path d="m6 6 12 12M18 6 6 18"></path></svg>Cancel upload</button>
        </div>
      </dialog>
      <dialog id="ttm-save-dialog" class="ttm-dialog" aria-labelledby="ttm-save-title">
        <form id="ttm-save-form">
          <div class="ttm-dialog-body">
            <h2 id="ttm-save-title">Save matching session</h2>
            <p>Save this review to the Shopify customer account so you and a TengTools sales representative can reopen it later.</p>
            <label for="ttm-session-name">Session name
              <input id="ttm-session-name" name="name" maxlength="120" required autocomplete="off" placeholder="e.g. September workshop RFQ">
            </label>
            <label for="ttm-session-status">Status
              <select id="ttm-session-status" name="status">
                <option value="In progress">In progress</option>
                <option value="Ready">Ready to discuss</option>
              </select>
            </label>
          </div>
          <div class="ttm-dialog-actions">
            <button class="ttm-secondary" type="button" data-save-cancel><svg class="ttm-icon" aria-hidden="true" viewBox="0 0 24 24"><path d="m6 6 12 12M18 6 6 18"></path></svg>Cancel</button>
            <button class="ttm-primary" type="submit"><svg class="ttm-icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M5 4h12l2 2v14H5z"></path><path d="M8 4v6h8V4M8 16h8"></path></svg>Save session</button>
          </div>
        </form>
      </dialog>
      <dialog id="ttm-sessions-dialog" class="ttm-dialog" aria-labelledby="ttm-sessions-title">
        <div class="ttm-dialog-body">
          <h2 id="ttm-sessions-title">Saved sessions</h2>
          <p>Choose a session to replace the current table with its saved matching results.</p>
          <div id="ttm-session-list" class="ttm-session-list" aria-live="polite"><div class="ttm-session-empty">Loading saved sessions…</div></div>
        </div>
        <div class="ttm-dialog-actions">
          <button class="ttm-secondary" type="button" data-sessions-close><svg class="ttm-icon" aria-hidden="true" viewBox="0 0 24 24"><path d="m6 6 12 12M18 6 6 18"></path></svg>Close</button>
        </div>
      </dialog>
      <dialog id="ttm-clear-dialog" class="ttm-dialog" aria-labelledby="ttm-clear-title">
        <div class="ttm-dialog-body">
          <h2 id="ttm-clear-title">Clear the table?</h2>
          <p>This will remove every row from the current matching table.</p>
        </div>
        <div class="ttm-dialog-actions">
          <button class="ttm-secondary" type="button" data-dialog-cancel><svg class="ttm-icon" aria-hidden="true" viewBox="0 0 24 24"><path d="m6 6 12 12M18 6 6 18"></path></svg>Cancel</button>
          <button class="ttm-primary" type="button" data-dialog-confirm><svg class="ttm-icon" aria-hidden="true" viewBox="0 0 24 24"><path d="m5 12 4 4L19 6"></path></svg>Continue</button>
        </div>
      </dialog>
      <dialog id="ttm-clear-final-dialog" class="ttm-dialog" aria-labelledby="ttm-clear-final-title">
        <div class="ttm-dialog-body">
          <h2 id="ttm-clear-final-title">Are you sure?</h2>
          <p>This is the final confirmation. All rows will be removed and cannot be restored. Download first if you need a copy.</p>
        </div>
        <div class="ttm-dialog-actions">
          <button class="ttm-secondary" type="button" data-final-cancel><svg class="ttm-icon" aria-hidden="true" viewBox="0 0 24 24"><path d="m6 6 12 12M18 6 6 18"></path></svg>Keep Table</button>
          <button class="ttm-danger ttm-danger--solid" type="button" data-final-confirm><svg class="ttm-icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M4 7h16M9 7V4h6v3M7 7l1 13h8l1-13"></path></svg>Clear Table</button>
        </div>
      </dialog>
    </main>

    <script src="{{ 'tt-match.js' | asset_url }}" defer></script>
  {% else %}
    <main class="page-width ttm-shell">
      <section class="ttm-gate" aria-labelledby="ttm-login-title">
        <h1 id="ttm-login-title">Sign in to use the product matcher</h1>
        <p>The cross-reference tool and downloadable procurement workbook are available to registered TengTools customers.</p>
        <div class="ttm-gate-actions">
          <a class="ttm-primary" href="/customer_authentication/login?return_to={{ request.path | url_encode }}"><svg class="ttm-icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M10 17l5-5-5-5M15 12H3M14 4h5a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2h-5"></path></svg>Log in</a>
          <a class="ttm-secondary" href="/customer_authentication/login?return_to={{ request.path | url_encode }}"><svg class="ttm-icon" aria-hidden="true" viewBox="0 0 24 24"><circle cx="9" cy="8" r="4"></circle><path d="M2 21a7 7 0 0 1 14 0M19 8v6M16 11h6"></path></svg>Create an account</a>
        </div>
      </section>
    </main>
  {% endif %}
</div>
