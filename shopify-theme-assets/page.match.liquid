  #tt-match .ttm-component { display:grid; grid-template-columns:minmax(220px,1.1fr) minmax(160px,.8fr) minmax(240px,1fr) minmax(240px,auto); gap:12px; align-items:start; padding:12px; border:1px solid #dce1e5; border-radius:0; background:#fff; }
  #tt-match .ttm-component + .ttm-component { margin-top:8px; }
