  #tt-match .ttm-action-menu summary:hover { border-color:#8f98a3; color:#111; background:#f7f8f9; }
  #tt-match .ttm-action-menu summary::-webkit-details-marker { display:none; }
  #tt-match .ttm-action-menu summary .ttm-icon { width:14px; height:14px; transition:transform .16s ease; }
  #tt-match .ttm-action-menu[open] summary .ttm-icon { transform:rotate(180deg); }
  #tt-match .ttm-action-list { position:fixed; z-index:30; width:172px; padding:6px; border:1px solid #d7dce1; background:#fff; box-shadow:0 12px 28px rgba(17,17,17,.16); }
  #tt-match .ttm-action-list button { display:flex; align-items:center; justify-content:flex-start; gap:9px; width:100%; min-height:38px; padding:8px 10px; border:0; color:#252a31; background:#fff; font-size:12px; font-weight:600; letter-spacing:0; text-align:left; text-transform:none; }
  #tt-match .ttm-action-list button:hover { color:#111; background:#f2f3f4; }
  #tt-match .ttm-action-list .ttm-delete:hover { color:#9f1f18; background:#fff1f0; }
  #tt-match .ttm-delete { border-color:#d8dde2; color:#59616c; background:#fff; }
  #tt-match .ttm-delete:hover { border-color:#b3261e; color:#9f1f18; background:#fff4f3; }
  #tt-match .ttm-number { font-variant-numeric:tabular-nums; font-weight:600; }
  #tt-match .ttm-group-toggle { display:inline-flex; align-items:center; gap:5px; margin-top:9px; padding:5px 8px; border:1px solid #c9cfd6; border-radius:0; color:#111; background:#fff; font-size:11px; font-weight:800; }
