  #tt-match .ttm-gate-actions .ttm-primary { color:#fff; }
  #tt-match .ttm-gate-actions .ttm-secondary { color:#111; }
  #tt-match .ttm-dialog { width:min(460px,calc(100% - 32px)); padding:0; border:0; border-radius:0; color:#111; box-shadow:0 22px 70px rgba(0,0,0,.28); }
  #tt-match .ttm-dialog::backdrop { background:rgba(0,0,0,.48); }
  #tt-match .ttm-dialog-body { padding:25px; }
  #tt-match .ttm-dialog h2 { margin:0 0 9px; font-size:22px; }
  #tt-match .ttm-dialog p { margin:0; color:var(--muted); line-height:1.5; }
  #tt-match .ttm-dialog label { display:block; margin-top:18px; color:#303640; font-size:12px; font-weight:700; }
  #tt-match .ttm-dialog input,#tt-match .ttm-dialog select { display:block; width:100%; min-height:46px; margin-top:6px; padding:9px 11px; border:1px solid #9098a4; border-radius:0; color:#111; background:#fff; }
  #tt-match .ttm-dialog-actions { display:flex; flex-wrap:wrap; justify-content:flex-end; gap:8px; padding:16px 25px; border-top:1px solid var(--line); background:#fafafa; }
  #tt-match .ttm-session-list { display:grid; gap:8px; max-height:min(470px,60vh); margin-top:18px; overflow:auto; }
  #tt-match .ttm-session-item { display:grid; grid-template-columns:minmax(0,1fr) auto; align-items:center; gap:12px; width:100%; padding:13px; border:1px solid #d9dde2; color:#262c34; background:#fff; text-align:left; }
  #tt-match .ttm-session-item:hover { border-color:#9199a4; background:#f7f8f9; }
  #tt-match .ttm-session-item strong,#tt-match .ttm-session-item small { display:block; }
  #tt-match .ttm-session-item small { margin-top:4px; color:#68717d; font-size:11px; font-weight:500; }
  #tt-match .ttm-session-item .ttm-icon { color:#5b6470; }
  #tt-match .ttm-session-empty { padding:22px 12px; color:#68717d; text-align:center; }
  #tt-match .ttm-upload-dialog { width:min(520px,calc(100% - 32px)); }
  #tt-match .ttm-upload-file { display:block; margin:5px 0 18px; overflow:hidden; color:#111; font-weight:800; text-overflow:ellipsis; white-space:nowrap; }
  #tt-match .ttm-upload-progress-row { display:flex; align-items:center; gap:12px; }
  #tt-match .ttm-upload-progress-row progress { width:100%; height:12px; overflow:hidden; border:0; border-radius:999px; background:#e7e9ec; accent-color:var(--red); }
  #tt-match .ttm-upload-progress-row progress::-webkit-progress-bar { border-radius:999px; background:#e7e9ec; }
  #tt-match .ttm-upload-progress-row progress::-webkit-progress-value { border-radius:999px; background:var(--red); }
  #tt-match .ttm-upload-percent { min-width:42px; color:#3e4651; font-size:12px; font-weight:800; text-align:right; }
  #tt-match .ttm-upload-message { min-height:20px; margin-top:11px!important; font-size:13px; }
  #tt-match .ttm-visually-hidden { position:absolute!important; width:1px!important; height:1px!important; padding:0!important; margin:-1px!important; overflow:hidden!important; clip:rect(0,0,0,0)!important; white-space:nowrap!important; border:0!important; }
  body:has(#tt-match) > shopify-chat,
  body:has(#tt-match) #google-merchantwidget-iframe-wrapper { display:none!important; visibility:hidden!important; pointer-events:none!important; }
  @media (max-width:900px) {
    #tt-match .ttm-hero { align-items:stretch; flex-direction:column; gap:14px; }
    #tt-match .ttm-account { align-self:flex-start; min-width:235px; }
    #tt-match .ttm-suggestions { grid-template-columns:1fr 1fr; }
    #tt-match .ttm-results-head { align-items:flex-start; flex-direction:column; }
    #tt-match .ttm-head-actions { justify-content:flex-start; }
