{% comment %}
  TengTools South Africa — procurement cross-reference tool
  Customer-only, browser-side matching. Product/master data only; no pricing or stock.
{% endcomment %}

<style>
  #tt-match { --ink:#151515; --muted:#626a73; --line:#e1e4e7; --soft:#f4f5f6; --red:#ed1c24; --red-dark:#c9161d; --green:#177245; --green-soft:#eaf6ef; --review:#a21d18; --review-soft:#fff9f8; padding:1px 0; color:var(--ink); background:#f0f0f0; font-family:Montserrat,"Helvetica Neue",Arial,sans-serif; }
  #tt-match * { box-sizing:border-box; }
  #tt-match [hidden] { display:none!important; }
  #tt-match button,#tt-match input,#tt-match select,#tt-match label { font:inherit; }
  #tt-match label { margin:0; letter-spacing:normal; text-transform:none; }
  #tt-match button { cursor:pointer; }
  #tt-match button:disabled { cursor:not-allowed; opacity:.48; }
  #tt-match button:focus-visible,#tt-match input:focus-visible,#tt-match select:focus-visible,#tt-match a:focus-visible { outline:3px solid rgba(225,37,27,.28); outline-offset:2px; }
  #tt-match .ttm-shell { width:100%; max-width:1180px; margin:18px auto 72px; padding:0 20px; }
  #tt-match .ttm-hero { display:flex; align-items:center; justify-content:space-between; gap:28px; padding:8px 0 14px; color:var(--ink); background:transparent; }
  #tt-match .ttm-hero-copy { min-width:0; }
  #tt-match .ttm-eyebrow { margin:0 0 8px; color:var(--red); font-size:12px; font-weight:700; letter-spacing:.14em; text-transform:uppercase; }
  #tt-match h1 { margin:0; color:var(--ink); font-size:clamp(28px,3vw,38px); font-weight:700; line-height:1.04; letter-spacing:.012em; text-transform:uppercase; }
  #tt-match .ttm-title-rule { display:block; width:72px; height:4px; margin:12px 0 0; background:var(--red); }
  #tt-match .ttm-hero p { max-width:820px; margin:11px 0 0; color:#4f4f4f; font-size:15px; line-height:1.65; }
  #tt-match .ttm-account { display:flex; flex:0 0 auto; align-items:center; gap:11px; min-width:235px; padding:10px 12px; border:1px solid #d6dbe1; border-radius:3px; color:#414852; background:#fff; box-shadow:0 1px 2px rgba(17,17,17,.04); font-size:12px; text-align:left; }
  #tt-match .ttm-avatar { position:relative; display:flex; flex:0 0 42px; align-items:center; justify-content:center; width:42px; height:42px; overflow:hidden; border:1px solid #d8dde3; border-radius:50%; color:#fff; background:#252a31; font-size:13px; font-weight:800; letter-spacing:.04em; }
  #tt-match .ttm-avatar img { position:absolute; inset:0; z-index:1; width:100%; height:100%; object-fit:cover; }
  #tt-match .ttm-account-copy { min-width:0; }
  #tt-match .ttm-account strong { display:block; overflow:hidden; margin:0 0 4px; color:#111; font-size:13px; line-height:1.2; text-overflow:ellipsis; white-space:nowrap; }
  #tt-match .ttm-account-links { display:flex; flex-wrap:wrap; align-items:center; gap:5px; line-height:1.2; }
  #tt-match .ttm-account a { color:#4e5661; text-decoration:underline; text-underline-offset:2px; }
  #tt-match .ttm-account a:hover { color:#111; }
  #tt-match .ttm-panel { margin-top:28px; border:0; border-radius:0; background:#fff; box-shadow:0 2px 8px rgba(0,0,0,.08); }
  #tt-match .ttm-start { position:relative; padding:38px; }
  #tt-match .ttm-start { scroll-margin-top:18px; }
  #tt-match .ttm-start.is-manual-matching { box-shadow:inset 0 3px 0 var(--red),0 2px 8px rgba(0,0,0,.08); }
  #tt-match .ttm-start h2,#tt-match .ttm-results-head h2 { margin:0; font-size:25px; font-weight:700; line-height:1.2; letter-spacing:-.015em; text-transform:uppercase; }
  #tt-match .ttm-start > h2 { padding-right:44px; }
  #tt-match .ttm-start h2:after,#tt-match .ttm-results-head h2:after { display:block; width:54px; height:4px; margin-top:12px; background:var(--red); content:""; }
  #tt-match .ttm-start-intro { margin:8px 0 22px; color:var(--muted); line-height:1.5; }
  #tt-match .ttm-manual-context { display:flex; align-items:center; justify-content:space-between; gap:18px; margin:0 0 14px; padding:11px 13px; border:1px solid #d8dce1; border-radius:0; color:#2f353d; background:#f7f8f9; box-shadow:inset 3px 0 0 var(--red); }
  #tt-match .ttm-manual-context[hidden] { display:none; }
  #tt-match .ttm-manual-context strong,#tt-match .ttm-manual-context span { display:block; }
  #tt-match .ttm-manual-context span { margin-top:3px; color:#69717c; font-size:12px; line-height:1.4; }
  #tt-match .ttm-manual-context .ttm-quiet { flex:0 0 auto; min-height:34px; padding:6px 9px; border-color:transparent; background:transparent; font-size:11px; font-weight:600; letter-spacing:0; text-transform:none; }
  #tt-match .ttm-entry { display:grid; grid-template-columns:minmax(260px,1fr) auto auto; align-items:stretch; gap:10px; width:100%; }
  #tt-match .ttm-start.is-manual-matching .ttm-entry { grid-template-columns:minmax(260px,1fr) auto; }
  #tt-match .ttm-start.is-manual-matching .ttm-upload-primary { display:none; }
  #tt-match .ttm-input { width:100%; min-height:54px; padding:0 17px; border:1px solid #aeb5bf; border-radius:0; background:#fff; color:#111; }
  #tt-match .ttm-primary,#tt-match .ttm-secondary,#tt-match .ttm-quiet,#tt-match .ttm-danger,#tt-match .ttm-delete { display:inline-flex; align-items:center; justify-content:center; gap:7px; min-height:44px; padding:10px 17px; border:2px solid transparent; border-radius:0; font-size:12px; font-weight:700; letter-spacing:.05em; line-height:1.2; text-align:center; text-decoration:none; text-transform:uppercase; transition:color .16s ease,background-color .16s ease,border-color .16s ease,box-shadow .16s ease; }
  #tt-match .ttm-icon { flex:0 0 auto; width:17px; height:17px; fill:none; stroke:currentColor; stroke-width:2; stroke-linecap:round; stroke-linejoin:round; }
  #tt-match .ttm-entry .ttm-primary { min-height:54px; }
  #tt-match .ttm-upload-primary { white-space:nowrap; }
  #tt-match .ttm-primary { border-color:var(--red); color:#fff; background:var(--red); }
  #tt-match .ttm-primary:hover { border-color:#151515; background:#151515; }
  #tt-match .ttm-primary:active { box-shadow:inset 0 2px 0 rgba(0,0,0,.22); transform:translateY(1px); }
  #tt-match .ttm-secondary { border-color:#151515; color:#151515; background:#fff; }
  #tt-match .ttm-secondary:hover { color:#fff; background:#151515; }
  #tt-match .ttm-quiet { border-color:var(--line); color:#3f4650; background:#fff; }
  #tt-match .ttm-quiet:hover { border-color:#aeb5be; color:#111; background:#f2f3f4; }
  #tt-match .ttm-danger { border-color:#e4aaa7; color:var(--review); background:#fff; }
  #tt-match .ttm-danger:hover { border-color:#b3261e; color:#fff; background:#b3261e; }
  #tt-match .ttm-danger--solid { border-color:#b3261e; color:#fff; background:#b3261e; }
  #tt-match .ttm-danger--solid:hover { border-color:#781712; background:#781712; }
  #tt-match .ttm-file { position:absolute; width:1px; height:1px; overflow:hidden; clip:rect(0 0 0 0); }
  #tt-match .ttm-data-info { position:absolute; top:18px; right:18px; z-index:20; display:flex; justify-content:flex-end; margin:0; }
  #tt-match .ttm-info-trigger { display:inline-flex; align-items:center; justify-content:center; width:34px; height:34px; padding:0; border:0; border-radius:0; color:#5c6570; background:transparent; font-size:21px; font-weight:700; line-height:1; }
  #tt-match .ttm-info-trigger:hover,#tt-match .ttm-info-trigger[aria-expanded="true"] { color:#111; background:#eceef0; }
  #tt-match .ttm-info-box { position:absolute; top:calc(100% + 7px); right:0; z-index:20; width:min(370px,calc(100vw - 48px)); padding:18px 42px 17px 18px; border:1px solid #d6dbe1; color:#303640; background:#fff; box-shadow:0 14px 36px rgba(17,17,17,.16); }
  #tt-match .ttm-info-box[hidden] { display:none; }
  #tt-match .ttm-info-box strong { display:block; margin:0 0 9px; color:#111; font-size:13px; }
  #tt-match .ttm-info-box p { margin:0 0 9px; color:#525b67; font-size:12px; line-height:1.5; }
  #tt-match .ttm-info-box p:last-child { margin-bottom:0; }
  #tt-match .ttm-info-close { position:absolute; top:8px; right:8px; display:inline-flex; align-items:center; justify-content:center; width:30px; height:30px; padding:0; border:0; color:#545d68; background:transparent; }
  #tt-match .ttm-info-close:hover { color:#fff; background:#111; }
  #tt-match .ttm-scope { max-width:980px; margin:30px 0 0; padding:0; border:0; }
  #tt-match .ttm-scope legend { margin:0 0 9px; padding:0; color:#303640; font-size:13px; font-weight:800; }
  #tt-match .ttm-scope-options { display:flex; flex-wrap:wrap; gap:8px; }
  #tt-match .ttm-scope-option { position:relative; display:inline-flex; align-items:center; min-height:40px; padding:7px 12px; border:1px solid #cbd1d8; border-radius:0; color:#4a525d; background:#fff; font-size:12px; font-weight:600; letter-spacing:0; text-transform:none; cursor:pointer; }
  #tt-match .ttm-scope-option:hover { border-color:#858e99; background:#f7f8f9; }
  #tt-match .ttm-scope-option:has(input:checked) { border-color:#969ea8; color:#222831; background:#eef0f2; }
  #tt-match .ttm-scope-option input { position:absolute; width:1px; height:1px; opacity:0; }
  #tt-match .ttm-scope-icon { flex:0 0 auto; width:17px; height:17px; margin-right:7px; fill:none; stroke:currentColor; stroke-width:2; stroke-linecap:round; stroke-linejoin:round; }
  #tt-match .ttm-scope-icon--active { display:none; }
  #tt-match .ttm-scope-option:has(input:checked) .ttm-scope-icon--active { display:block; }
  #tt-match .ttm-scope-option:has(input:checked) .ttm-scope-icon--inactive { display:none; }
  #tt-match .ttm-scope-note { display:block; margin-top:8px; color:var(--muted); font-size:12px; line-height:1.4; }
  #tt-match .ttm-ai-control { display:flex; align-items:center; gap:8px; margin-top:12px; color:#4a525d; font-size:12px; }
  #tt-match .ttm-ai-control input { width:16px; height:16px; margin:0; accent-color:#111; }
  #tt-match .ttm-ai-control strong { color:#222831; font-weight:700; }
  #tt-match .ttm-brands { display:flex; flex-wrap:wrap; gap:7px; margin-top:18px; }
  #tt-match .ttm-chip { padding:5px 9px; border:1px solid #d8dce1; border-radius:999px; color:#4d5561; background:#fafafa; font-size:12px; }
  #tt-match .ttm-statusline { min-height:22px; margin:18px 0 0; color:#3b4350; font-size:13px; }
  #tt-match .ttm-statusline[data-tone="error"] { color:var(--review); font-weight:700; }
  #tt-match .ttm-statusline[data-tone="success"] { color:var(--green); font-weight:700; }
  #tt-match .ttm-suggestions { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:10px; margin-top:18px; }
  #tt-match .ttm-suggestion { display:grid; grid-template-columns:72px minmax(0,1fr); grid-template-rows:auto 1fr; gap:12px 14px; min-width:0; padding:15px; border:1px solid #dfe3e7; border-radius:0; background:#fff; transition:border-color .16s ease,box-shadow .16s ease; }
  #tt-match .ttm-suggestion:hover { border-color:#aeb5be; box-shadow:0 2px 7px rgba(17,17,17,.06); }
  #tt-match .ttm-suggestion--message { grid-template-columns:1fr; }
  #tt-match .ttm-suggestion-media { grid-row:1/3; }
  #tt-match .ttm-suggestion-copy { min-width:0; }
  #tt-match .ttm-suggestion small { color:var(--muted); }
  #tt-match .ttm-suggestion strong { display:block; margin:5px 0; line-height:1.35; }
  #tt-match .ttm-content-match { display:block; margin-top:8px; color:#3f4752; line-height:1.4; }
  #tt-match .ttm-suggestion .ttm-primary,#tt-match .ttm-suggestion .ttm-danger { align-self:end; justify-self:start; min-height:34px; padding:6px 9px; border-width:1px; border-color:#c7cdd4; color:#252a31; background:#fff; font-size:11px; font-weight:600; letter-spacing:0; text-transform:none; }
  #tt-match .ttm-suggestion .ttm-primary:hover,#tt-match .ttm-suggestion .ttm-danger:hover { border-color:#151515; color:#fff; background:#151515; }
  #tt-match .ttm-suggestion .ttm-primary .ttm-icon,#tt-match .ttm-suggestion .ttm-danger .ttm-icon { width:15px; height:15px; }
  #tt-match .ttm-pagination { display:flex; align-items:center; justify-content:space-between; gap:16px; margin-top:16px; padding-top:16px; border-top:1px solid var(--line); }
  #tt-match .ttm-pagination-summary { color:var(--muted); font-size:13px; white-space:nowrap; }
  #tt-match .ttm-pagination-controls { display:flex; flex-wrap:wrap; align-items:center; justify-content:flex-end; gap:6px; }
  #tt-match .ttm-page-button { display:inline-flex; align-items:center; justify-content:center; gap:5px; min-width:40px; min-height:40px; padding:7px 11px; border:1px solid #cbd1d8; border-radius:0; color:#252a31; background:#fff; font-weight:700; line-height:1; }
  #tt-match .ttm-page-button:hover:not(:disabled) { border-color:#7d8793; background:#f4f5f6; }
  #tt-match .ttm-page-button[aria-current="page"] { border-color:#111; color:#fff; background:#111; }
  #tt-match .ttm-page-direction { min-width:82px; }
  #tt-match .ttm-page-ellipsis { min-width:24px; color:var(--muted); text-align:center; }
  #tt-match .ttm-product-image { display:block; width:64px; height:64px; border:1px solid #e0e4e8; border-radius:0; background:#fff; object-fit:contain; }
  #tt-match .ttm-image-fallback { display:flex; align-items:center; justify-content:center; width:64px; height:64px; border:1px solid #e0e4e8; border-radius:0; color:#7b838d; background:#f4f5f6; font-size:10px; font-weight:800; text-align:center; }
  #tt-match .ttm-results { overflow:hidden; }
  #tt-match .ttm-results-head { display:flex; align-items:center; justify-content:space-between; gap:16px; padding:30px 32px; border-bottom:1px solid var(--line); }
  #tt-match .ttm-counts { display:flex; flex-wrap:wrap; gap:7px; margin-top:8px; color:var(--muted); font-size:13px; }
  #tt-match .ttm-counts span { padding-right:8px; border-right:1px solid #ccd1d7; }
  #tt-match .ttm-counts span:last-child { border:0; }
  #tt-match .ttm-head-actions { display:flex; flex-wrap:wrap; justify-content:flex-end; gap:8px; }
  #tt-match .ttm-head-actions .ttm-primary { min-height:46px; padding:11px 20px; }
  #tt-match .ttm-head-actions .ttm-secondary { min-height:40px; padding:8px 13px; border-width:1px; font-size:11.5px; font-weight:600; letter-spacing:.01em; text-transform:none; }
  #tt-match #ttm-clear-saved { border-color:#d8aaa7; color:#8d2a25; background:#fff; }
  #tt-match #ttm-clear-saved:hover { border-color:#b3261e; color:#8d2a25; background:#fff4f3; }
  #tt-match .ttm-tools { position:relative; display:flex; flex-wrap:wrap; align-items:center; gap:7px; padding:11px 20px; border-bottom:1px solid var(--line); background:#fafafa; }
  #tt-match .ttm-tools .ttm-quiet { min-height:38px; padding:7px 10px; border-width:1px; font-size:11px; font-weight:600; letter-spacing:0; text-transform:none; }
  #tt-match .ttm-tools .ttm-icon { width:15px; height:15px; }
  #tt-match .ttm-filter[aria-pressed="true"] { color:#fff; border-color:#111; background:#111; }
  #tt-match #ttm-reset-columns { border-color:transparent; color:#626a75; background:transparent; }
  #tt-match #ttm-reset-columns:hover { border-color:#d5d9de; color:#222831; background:#fff; }
  #tt-match .ttm-columns-control { position:relative; margin-left:auto; }
  #tt-match .ttm-columns-trigger { min-width:44px; padding-inline:10px; color:#3f4650; background:#fff; }
  #tt-match .ttm-kebab { font-size:19px; font-weight:800; line-height:1; letter-spacing:2px; transform:translateY(-1px); }
  #tt-match .ttm-columns-menu { position:absolute; top:calc(100% + 7px); right:0; z-index:12; width:250px; max-height:min(420px,70vh); overflow:auto; padding:8px; border:1px solid #d7dce1; background:#fff; box-shadow:0 14px 36px rgba(17,17,17,.16); }
  #tt-match .ttm-columns-menu[hidden] { display:none; }
  #tt-match .ttm-columns-menu-title { display:block; padding:8px 9px 10px; border-bottom:1px solid #e4e7ea; color:#111; font-size:12px; font-weight:800; }
  #tt-match .ttm-column-option { display:flex; align-items:center; gap:9px; min-height:36px; padding:7px 9px; color:#303640; font-size:12px; cursor:pointer; }
  #tt-match .ttm-column-option:hover { background:#f4f5f6; }
  #tt-match .ttm-column-option input { width:16px; height:16px; margin:0; accent-color:#111; }
  #tt-match .ttm-table-wrap { width:100%; overflow-x:auto; }
  #tt-match .ttm-mobile-summary-cell { display:none; }
  #tt-match table { width:100%; min-width:100%; table-layout:fixed; border-collapse:collapse; }
  #tt-match th,#tt-match td { padding:11px 10px; border-bottom:1px solid var(--line); text-align:left; vertical-align:top; font-size:12px; font-weight:400; line-height:1.4; }
  #tt-match th { position:sticky; top:0; z-index:1; color:#59616b; background:#f3f6f8; font-size:10.5px; font-weight:600; line-height:1.25; letter-spacing:.01em; text-align:left; text-transform:none; cursor:grab; }
  #tt-match th:active { cursor:grabbing; }
  #tt-match th button { display:inline-flex; align-items:center; gap:5px; padding:0; border:0; color:inherit; background:transparent; font:inherit; font-weight:600; letter-spacing:inherit; text-align:left; text-transform:none; }
  #tt-match th > span:not(.ttm-column-resizer) { display:inline-flex; align-items:center; min-height:14px; font:inherit; }
  #tt-match .ttm-sort-icon { color:#858d98; font-size:11px; font-weight:400; }
  #tt-match th[aria-sort] .ttm-sort-icon { color:#111; }
  #tt-match th.is-dragging { opacity:.42; }
  #tt-match th.is-drop-target { box-shadow:inset 3px 0 0 var(--red); }
  #tt-match th[data-column="row"] { width:4%; }
  #tt-match th[data-column="inputBrand"] { width:6%; }
  #tt-match th[data-column="inputId"] { width:7%; }
  #tt-match th[data-column="inputTitle"] { width:16%; }
  #tt-match th[data-column="quantity"] { width:4%; }
  #tt-match th[data-column="unit"] { width:4%; }
  #tt-match th[data-column="status"] { width:5%; }
  #tt-match th[data-column="category"] { width:10%; }
  #tt-match th[data-column="tengSku"] { width:7%; }
  #tt-match th[data-column="tengTitle"] { width:14%; }
  #tt-match th[data-column="unspsc"] { width:10%; }
  #tt-match th[data-column="actions"] { width:10%; }
  #tt-match td { overflow-wrap:anywhere; }
  #tt-match td[data-column="row"] br,#tt-match td[data-column="row"] small { display:none; }
  #tt-match .ttm-column-resizer { position:absolute; top:0; right:0; bottom:0; z-index:2; width:6px; cursor:col-resize; }
  #tt-match .ttm-column-resizer:hover { background:rgba(225,37,27,.16); }
  body.ttm-is-resizing,body.ttm-is-resizing * { cursor:col-resize!important; user-select:none!important; }
  #tt-match .ttm-category-tag { display:inline-flex; align-items:center; min-height:22px; padding:3px 7px; border:1px solid #dce1e5; color:#39414b; background:#f4f7f9; font-size:10px; font-weight:600; line-height:1.2; }
  #tt-match tr.is-review > td { background:var(--review-soft); }
  #tt-match tr.is-ignored > td { color:#777; background:#f5f5f5; }
  #tt-match tr.ttm-undo-row > td { padding:10px 12px; background:#fff8f7; box-shadow:inset 4px 0 0 var(--red); }
  #tt-match .ttm-undo { display:flex; align-items:center; gap:10px; min-height:44px; color:#4f3331; }
  #tt-match .ttm-undo strong { color:#8f201a; }
  #tt-match .ttm-undo .ttm-secondary { min-height:36px; padding:7px 11px; }
  #tt-match .ttm-undo-countdown { color:var(--muted); font-size:12px; white-space:nowrap; }
  #tt-match tr.is-matched > td:first-child { box-shadow:inset 4px 0 0 var(--green); }
  #tt-match tr.is-review > td:first-child { box-shadow:inset 4px 0 0 var(--red); }
  #tt-match .ttm-sku { font-weight:650; white-space:normal; overflow-wrap:anywhere; }
  #tt-match .ttm-product-cell { display:grid; grid-template-columns:44px minmax(0,1fr); align-items:start; gap:8px; min-width:0; }
  #tt-match .ttm-product-cell .ttm-product-image,#tt-match .ttm-product-cell .ttm-image-fallback { width:44px; height:44px; }
  #tt-match .ttm-product-title { min-width:0; }
  #tt-match .ttm-product-title a { color:#111; font-weight:600; overflow-wrap:normal; word-break:normal; text-decoration:underline; text-decoration-color:#cdd2d7; text-underline-offset:2px; }
  #tt-match .ttm-product-title small { display:block; margin-top:4px; color:var(--muted); }
  #tt-match .ttm-status-indicators { display:flex; flex-wrap:wrap; align-items:center; gap:7px; min-width:47px; }
  #tt-match .ttm-badge { display:inline-flex; align-items:center; justify-content:center; width:20px; height:20px; padding:0; border:0; border-radius:0; background:transparent; cursor:help; }
  #tt-match .ttm-badge .ttm-icon { width:18px; height:18px; }
  #tt-match .ttm-badge:focus-visible { outline:2px solid #111; outline-offset:2px; }
  #tt-match .ttm-badge--matched { color:#147143; }
  #tt-match .ttm-badge--review { color:#b3261e; }
  #tt-match .ttm-badge--ignored { color:#69717c; }
  #tt-match .ttm-badge--warning { color:#805600; }
